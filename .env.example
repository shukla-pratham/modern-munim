# Production / Docker Compose. Copy to .env and set values. Do not commit .env.

POSTGRES_USER=marketplace
POSTGRES_PASSWORD=
POSTGRES_DB=marketplace_db

SECRET_KEY=

CORS_ORIGINS=http://localhost
# Browser-reachable FastAPI origin. The frontend nginx config does not proxy /api.
VITE_API_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

LOG_LEVEL=info

# ── Email delivery (Resend HTTPS API) ──────────────────────────────────────
# Required in production. Obtain a key at https://resend.com
# SMTP variables below are a development-only fallback; not used in production.
RESEND_API_KEY=
# Sender address. Use onboarding@resend.dev for testing (Resend sandbox).
# In production, set a verified domain address, e.g. noreply@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Gmail / SMTP (development fallback only) ───────────────────────────────
# Not used in production. Use a Google App Password, not your account password.
SMTP_USER=
SMTP_PASSWORD=
