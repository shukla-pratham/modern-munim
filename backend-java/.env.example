# JDBC URL for Spring Boot (note: jdbc:postgresql, not SQLAlchemy postgresql://)
DATABASE_URL=jdbc:postgresql://localhost:5432/marketplace_db
DATABASE_USERNAME=prathamshukla
DATABASE_PASSWORD=

# Must match FastAPI SECRET_KEY if tokens are to be interchangeable during dual-run
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SERVER_PORT=8080
LOG_LEVEL=INFO

# Future Python AI sidecar (FastAPI AI routes remain on :8000 during migration)
AI_SERVICE_URL=http://localhost:8000

# Safer admin provisioning (Spring only). Required to call POST /api/auth/bootstrap-admin
# when no admin user exists yet.
BOOTSTRAP_ADMIN_TOKEN=
