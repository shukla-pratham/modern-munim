# Required in production
DATABASE_URL=postgresql://user:password@localhost:5432/marketplace_db
SECRET_KEY=your-secret-key-here-change-in-production-minimum-32-chars

# Optional (have defaults)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
AI_BATCH_JOB_TIMEOUT_HOURS=2
RATE_LIMIT_LOGIN_PER_MINUTE=10
JWT_COOKIE_NAME=

# Resend HTTPS email API (required in production for transactional email)
# Get your key at https://resend.com → API Keys
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# SMTP fallback (optional — used if RESEND_API_KEY is not set, in development only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your.gmail@gmail.com

# Development helpers
# Set to "true" to log email content to the server console instead of sending (dev only).
# Must be "false" in production.
EMAIL_OTP_DEV_LOG=false

# NOTES:
# - Authentication uses email + password directly. No OTP is required.
# - SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# - DATABASE_URL is your PostgreSQL connection string
