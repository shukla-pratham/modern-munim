# Required in production (see DEPLOY.md)
DATABASE_URL=postgresql://user:password@localhost:5432/marketplace_db
SECRET_KEY=your-secret-key-here-change-in-production-minimum-32-chars

# Optional (have defaults)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
AI_BATCH_JOB_TIMEOUT_HOURS=2
RATE_LIMIT_LOGIN_PER_MINUTE=10
JWT_COOKIE_NAME=

# IMPORTANT NOTES:
# - NO external API keys are required
# - SECRET_KEY is internally generated (not from a third party)
# - Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# - DATABASE_URL is your PostgreSQL connection string (not an API key)
# - See CONFIGURATION.md for complete documentation
